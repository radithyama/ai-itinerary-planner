# Copy to .env.local for local development.

# Postgres connection string (production: Postgres 15 on portfolio-vm, localhost only)
DATABASE_URL=postgresql://planit:password@localhost:5432/planit

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=

# Optional: max new plans per user per 24h (default 10)
PLANIT_DAILY_LIMIT=

# Optional: serve under a sub-path, e.g. /planit (set at build time)
NEXT_PUBLIC_BASE_PATH=
